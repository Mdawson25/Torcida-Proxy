{
  "name": "torcida",
  "version": "0.1.0",
  "private": true,
  "description": "Torcida web app and bundled iOS beta",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build-web.mjs",
    "build:ios": "node scripts/build-ios.mjs",
    "ios:add": "npm run build:ios && cap add ios && node scripts/configure-ios.mjs",
    "ios:sync": "npm run build:ios && cap sync ios && node scripts/configure-ios.mjs",
    "ios:open": "cap open ios",
    "ios:check": "node scripts/check-ios.mjs"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "^0.25.0",
    "plist": "3.1.0"
  }
}
